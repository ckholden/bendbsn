{
  "rules": {
    ".read": false,
    ".write": false,
    "userDocuments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true))"
      }
    },
    "carePlans": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sbarReports": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rotationLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rotationChecklists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "appTickets": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".indexOn": ["timestamp", "status", "userEmail", "uid", "email"],
      "$ticketId": {
        ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && newData.child('message').val() === data.child('message').val() && newData.child('status').val() === data.child('status').val() && newData.child('adminNotes').val() === data.child('adminNotes').val() && newData.child('phase').val() === data.child('phase').val())))"
      }
    },
    "userProfiles": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".indexOn": ["isAdmin", "tenantId", "email"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
        ".write": "auth != null && (auth.uid === $uid || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
        "isAdmin": {
          ".validate": "root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true && (newData.isBoolean() || !newData.exists())"
        },
        "role_id": {
          ".validate": "newData.isString() && (newData.val() !== 'instructor' || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() !== 'Instructor' || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
        }
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
    },
    "banned": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
    },
    "globalPhrases": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
    },
    "loginHistory": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      "$entry": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },
    "userExportHistory": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notificationLog": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      "$logId": {
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('email').isString() && newData.child('email').val().toLowerCase() === auth.token.email.toLowerCase()"
      }
    },
    "userActions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
        ".write": "auth != null && (auth.uid === $uid || root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
      }
    },
    "clientErrors": {
      ".read": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      ".indexOn": ["timestamp", "uid"],
      "$errId": {
        ".write": "auth != null && !data.exists() && newData.exists() && (!newData.child('uid').exists() || newData.child('uid').val() === auth.uid)"
      },
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')"
    },
    "appConfig": {
      ".write": "auth != null && root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true",
      "roles": {
        ".read": true
      },
      "$other": {
        ".read": "auth != null"
      }
    },
    "emr": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('userProfiles').child(auth.uid).child('isAdmin').val() === true || root.child('userProfiles').child(auth.uid).child('role_id').val() === 'instructor')",
      "$section": {
        ".write": "auth != null && newData.exists()"
      }
    },
    "emr-clinical": {
      "packets": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".indexOn": ["updatedAt"]
        }
      }
    }
  }
}
